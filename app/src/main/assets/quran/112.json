[{"surahNumber":112,"ayahNumber":1,"arabicText":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","hinglishText":"Qul huwal laahu ahad","urduTranslation":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","hindiTranslation":"कहो, \"वह अल्लाह यकता है,"},{"surahNumber":112,"ayahNumber":2,"arabicText":"ٱللَّهُ ٱلصَّمَدُ","hinglishText":"Allah hus-samad","urduTranslation":"معبود برحق جو بےنیاز ہے","hindiTranslation":"अल्लाह निरपेक्ष (और सर्वाधार) है,"},{"surahNumber":112,"ayahNumber":3,"arabicText":"لَمْ يَلِدْ وَلَمْ يُولَدْ","hinglishText":"Lam yalid wa lam yoolad","urduTranslation":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","hindiTranslation":"न वह जनिता है और न जन्य,"},{"surahNumber":112,"ayahNumber":4,"arabicText":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","hinglishText":"Wa lam yakul-lahu kufuwan ahad","urduTranslation":"اور کوئی اس کا ہمسر نہیں","hindiTranslation":"और न कोई उसका समकक्ष है।\""}]